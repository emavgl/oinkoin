<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Strip INTERNET and ACCESS_NETWORK_STATE injected by transitive
         dependencies (Firebase telemetry via Play Billing AAR).  Billing
         communicates with the Play Store app via local Binder IPC — no
         network permission is needed. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
</manifest>
