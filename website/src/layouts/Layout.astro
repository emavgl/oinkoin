---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: object[];
}

const {
  title,
  description = "Free, offline, and privacy-focused expense tracker. Track your expenses without ads, data collection, or complexity. Open source and available for Android, Linux, and Windows.",
  ogImage = "/og-image.png",
  ogType = 'website',
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// Static structured data that applies to every page.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Oinkoin",
  "url": "https://oinkoin.com",
  "email": "emavgl.app@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Altenbauerstraße 12",
    "postalCode": "4060",
    "addressLocality": "Leonding",
    "addressCountry": "AT",
  },
  "logo": new URL("/oinkoin-icon.png", Astro.site),
  "sameAs": [
    "https://github.com/emavgl/oinkoin",
    "https://play.google.com/store/apps/details?id=com.github.emavgl.piggybank",
  ],
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Oinkoin",
  "description": "Free, offline, and privacy-focused expense tracker. No ads, no data collection, no account required.",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": ["Android", "Linux", "Windows"],
  "url": "https://oinkoin.com",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
  },
};

const schemas = [softwareSchema, organizationSchema, ...jsonLd];

import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="expense tracker, budget app, money manager, finance app, offline expense tracker, privacy focused, no ads, open source, Android, Linux, Windows, F-Droid, free expense tracker, personal finance, spending tracker" />
    <meta name="author" content="Oinkoin" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#000000" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/oinkoin-icon.png" />

    <title>{title}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Oinkoin - Free open-source expense tracker" />
    <meta property="og:site_name" content="Oinkoin" />
    <meta property="og:locale" content="en_US" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && (
      <meta property="article:author" content="https://github.com/emavgl" />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured Data -->
    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="bg-white text-gray-900 antialiased flex flex-col min-h-screen">
    <div role="note" aria-live="polite" class="bg-red-50 border-b border-red-200 text-red-900 text-sm">
      <div class="max-w-5xl mx-auto px-4 py-2 text-center">Notice: Oinkoin is not associated with any token or cryptocurrency project. <a href="/safety" class="font-medium underline ml-2">Learn how to avoid scams</a></div>
    </div>
    <NavBar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    height: 100%;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
</style>
