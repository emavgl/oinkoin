---
import Layout from '../layouts/Layout.astro';

const title = 'Impressum | Oinkoin';
const description = 'Provider and media-owner information for the Oinkoin website.';
---

<Layout title={title} description={description}>
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-6">
      <article class="max-w-3xl mx-auto text-gray-700 leading-relaxed">
        <header class="mb-10">
          <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4 tracking-tight">Impressum</h1>
          <p class="text-lg text-gray-600">Provider information pursuant to Austrian e-commerce law and, where applicable, the Austrian Media Act.</p>
        </header>

        <section class="space-y-4 mb-10">
          <h2 class="text-2xl font-bold text-gray-900">Media owner and service provider</h2>
          <address class="not-italic bg-gray-50 border border-gray-200 rounded-xl p-6">
            <strong class="text-gray-900">Emanuele Viglianisi</strong><br />
            Altenbauerstraße 12<br />
            4060 Leonding<br />
            Austria
          </address>
          <dl class="grid sm:grid-cols-[11rem_1fr] gap-x-4 gap-y-2">
            <dt class="font-semibold text-gray-900">Email</dt>
            <dd><a href="mailto:emavgl.app@gmail.com" class="text-blue-600 hover:underline">emavgl.app@gmail.com</a></dd>
            <dt class="font-semibold text-gray-900">Support</dt>
            <dd><a href="mailto:support@oinkoin.com" class="text-blue-600 hover:underline">support@oinkoin.com</a></dd>
            <dt class="font-semibold text-gray-900">Online contact</dt>
            <dd><a href="https://github.com/emavgl/oinkoin/issues" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">GitHub Issues</a></dd>
            <dt class="font-semibold text-gray-900">Website</dt>
            <dd><a href="https://oinkoin.com" class="text-blue-600 hover:underline">https://oinkoin.com</a></dd>
          </dl>
        </section>

        <section class="space-y-4 mb-10">
          <h2 class="text-2xl font-bold text-gray-900">Business activity</h2>
          <p>Development, provision, and distribution of the Oinkoin expense-tracking software, and operation of this website.</p>
          <p>Oinkoin is operated under the name of Emanuele Viglianisi. No separate company name is used on this website.</p>
        </section>

        <section class="space-y-4 mb-10">
          <h2 class="text-2xl font-bold text-gray-900">Responsible for content</h2>
          <p>Emanuele Viglianisi, at the address stated above.</p>
        </section>

        <section class="space-y-4 mb-10">
          <h2 class="text-2xl font-bold text-gray-900">Consumer information</h2>
          <p>This website is informational and promotional. It does not operate a checkout, collect orders, or process payments. Paid Oinkoin purchases are completed through Google Play, which displays the applicable purchase, seller, tax, payment, and refund information.</p>
          <p>For information about the Oinkoin Pro offer, including the one-time purchase and withdrawal information, see the <a href="/terms" class="text-blue-600 hover:underline">Terms &amp; Conditions</a>.</p>
        </section>

        <section class="space-y-4 mb-10">
          <h2 class="text-2xl font-bold text-gray-900">Applicable rules</h2>
          <p>Where a trade or professional regulation applies, the applicable Austrian regulations and registration details must be read together with this information. The Oinkoin website does not claim a regulated profession or special government authorization.</p>
          <p>Mandatory consumer protection rights remain unaffected by any information on this page.</p>
        </section>

        <p class="text-sm text-gray-500 border-t border-gray-200 pt-6">Last updated: 29 August 2026</p>
      </article>
    </div>
  </section>
</Layout>
